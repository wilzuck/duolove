{
  "name": "duomatch",
  "version": "0.1.0",
  "private": true,
  "description": "DuoMatch — plateforme de rencontres amoureuses. Deux cœurs, une belle histoire.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:api & pnpm dev:web & wait",
    "dev:web": "pnpm --filter @duomatch/web dev",
    "dev:api": "make -C backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @duomatch/web test:e2e",
    "test:api": "make -C backend test",
    "db:migrate": "make -C backend migrate",
    "db:seed": "make -C backend seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "audit:deps": "pnpm audit --prod",
    "verify": "bash scripts/verify.sh",
    "verify:full": "VERIFY_FULL=1 bash scripts/verify.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
