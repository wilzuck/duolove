{
  "name": "duomatch",
  "version": "0.1.0",
  "private": true,
  "description": "DuoMatch — plateforme de rencontres amoureuses. Deux cœurs, une belle histoire.",
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @duomatch/web dev",
    "dev:api": "pnpm --filter @duomatch/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @duomatch/web test:e2e",
    "db:migrate": "pnpm --filter @duomatch/api db:migrate",
    "db:seed": "pnpm --filter @duomatch/api db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "audit:deps": "pnpm audit --prod"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
