# DuoMatch — variables d'environnement (copier en .env / apps/api/.env). AUCUN secret réel ici.

# ───────── API (apps/api) ─────────
NODE_ENV=development
PORT=4000
# Base PostgreSQL (jamais la base de production en local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/duomatch?schema=public"
# URL publique du site web (CORS, liens des e-mails, contrôle d'Origin CSRF)
APP_URL="http://localhost:3000"
# URL publique de l'API (liens des photos)
API_URL="http://localhost:4000"
# Domaine du cookie de session en production si web et API sont sur des sous-domaines (ex. .duomatch.app)
# COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# true = e-mail à confirmer avant de liker/écrire (laisser true en production)
REQUIRE_EMAIL_VERIFICATION=true
# Dossier des fichiers envoyés (local). En production : volume persistant ou stockage S3 (voir docs/DEPLOYMENT.md)
UPLOAD_DIR="./uploads"

# E-mail transactionnel (SMTP). Sans SMTP_URL : e-mails journalisés/mémorisés en développement uniquement.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
MAIL_FROM="DuoMatch <no-reply@duomatch.example>"

# Connexion Google (console.cloud.google.com) — doit correspondre à NEXT_PUBLIC_GOOGLE_CLIENT_ID. Sans lui : bouton masqué.
# GOOGLE_CLIENT_ID=

# Paiement : "mock" = simulation (dev/CI) · "kkiapay" = réel (Mobile Money + carte). Voir docs/DEPLOYMENT.md.
PAYMENT_PROVIDER=mock
# Nom affiché dans le widget de paiement et sur les factures
SITE_NAME=DuoMatch
# KKiaPay (https://kkiapay.me → Tableau de bord → Développeurs). Requis si PAYMENT_PROVIDER=kkiapay.
# KKIAPAY_PUBLIC_KEY=
# KKIAPAY_PRIVATE_KEY=
# « Secret hash » saisi à la création du webhook (Tableau de bord → Webhooks). URL du webhook : {API_URL}/api/payments/webhook/kkiapay
# KKIAPAY_WEBHOOK_SECRET=
# true = bac à sable (aucun argent réel). Passer à false UNIQUEMENT avec les clés de production.
KKIAPAY_SANDBOX=true
# OBLIGATOIRES en production, à générer : openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
IP_HASH_SALT=dev-only-ip-salt

# ───────── Web (apps/web) ─────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# URL de l'API vue par le NAVIGATEUR pour le WebSocket et les images
NEXT_PUBLIC_API_URL="http://localhost:4000"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Adresse de support affichée sur /contact
NEXT_PUBLIC_SUPPORT_EMAIL="support@duomatch.example"

# ───────── Tests ─────────
# Base dédiée aux tests d'intégration API et aux E2E (jamais la base de développement)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/duomatch_test?schema=public"
