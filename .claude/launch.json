{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "duomatch-api",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "-C",
        "backend",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "duomatch-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@duomatch/web",
        "dev"
      ],
      "port": 3000
    }
  ]
}