# syntax=docker/dockerfile:1
# API FastAPI (Python). Build depuis la RACINE du dépôt : docker build -f docker/Dockerfile.api -t duomatch-api .
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend

FROM base AS build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM build AS run
ENV NODE_ENV=production
# Client PostgreSQL 18 (version du serveur de production) pour « Sauvegarder maintenant » dans l'admin (pg_dump) : dépôt officiel PGDG, absent des paquets Debian par défaut.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && . /etc/os-release \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-client-18 \
 && apt-get purge -y --auto-remove curl gnupg && rm -rf /var/lib/apt/lists/*
COPY backend/ .
RUN useradd --create-home app && mkdir -p /data/uploads && chown -R app /data/uploads
EXPOSE 4000
# Les migrations sont appliquées par le service « migrate » (docker-compose) ou : alembic upgrade head
USER app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4000", "--proxy-headers"]
