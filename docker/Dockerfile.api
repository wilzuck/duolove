# syntax=docker/dockerfile:1
# API FastAPI (Python). Build depuis la RACINE du dépôt : docker build -f docker/Dockerfile.api -t duomatch-api .
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend

FROM base AS build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM build AS run
ENV NODE_ENV=production
COPY backend/ .
RUN useradd --create-home app && mkdir -p /data/uploads && chown -R app /data/uploads
EXPOSE 4000
# Les migrations sont appliquées par le service « migrate » (docker-compose) ou : alembic upgrade head
USER app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4000", "--proxy-headers"]
